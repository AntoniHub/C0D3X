{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWeather current weather response",
  "type": "object",
  "required": ["coord", "weather", "main", "dt", "timezone", "id", "name", "cod"],
  "properties": {
    "coord": {
      "type": "object",
      "required": ["lon", "lat"],
      "properties": {
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "weather": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "main", "description", "icon"],
        "properties": {
          "id": { "type": "integer" },
          "main": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "icon": { "type": "string", "pattern": "^[0-9]{2}[dn]$" }
        }
      }
    },
    "main": {
      "type": "object",
      "required": ["temp", "feels_like", "temp_min", "temp_max", "pressure", "humidity"],
      "properties": {
        "temp": { "type": "number" },
        "feels_like": { "type": "number" },
        "temp_min": { "type": "number" },
        "temp_max": { "type": "number" },
        "pressure": { "type": "number", "minimum": 0 },
        "humidity": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "wind": {
      "type": "object",
      "required": ["speed"],
      "properties": {
        "speed": { "type": "number", "minimum": 0 },
        "deg": { "type": "number", "minimum": 0, "maximum": 360 },
        "gust": { "type": "number", "minimum": 0 }
      }
    },
    "clouds": {
      "type": "object",
      "required": ["all"],
      "properties": { "all": { "type": "number", "minimum": 0, "maximum": 100 } }
    },
    "dt": { "type": "integer", "minimum": 0 },
    "timezone": { "type": "integer" },
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "cod": { "type": "integer", "const": 200 }
  }
}
